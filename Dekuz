local function Equip()
    pcall(function()
        local c = LP.Character
        if not c then return end
        for _, t in pairs(c:GetChildren()) do
            if t:IsA("Tool") then return end
        end
        local bag = LP:FindFirstChild("Backpack")
        if not bag then return end
        for _, t in pairs(bag:GetChildren()) do
            if t:IsA("Tool") then
                local h = Hum()
                if h then h:EquipTool(t) end
                return
            end
        end
    end)
end

local AC = nil
local function findAC()
    pcall(function()
        local ok, cf = pcall(function()
            return require(LP.PlayerScripts:WaitForChild("CombatFramework", 2))
        end)
        if ok then AC = cf end
    end)
end
findAC()
task.spawn(function()
    while true do
        task.wait(10)
        if not AC then findAC() end
    end
end)

local function KillShake()
    pcall(function()
        local u = RS:FindFirstChild("Util")
        if u and u:FindFirstChild("CameraShaker") then
            local Cam = require(u.CameraShaker)
            if Cam and Cam.Stop then Cam:Stop() end
        end
    end)
end

local function Attack()
    KillShake()
    Equip()
    pcall(function()
        if AC and AC.activeController then
            local c = AC.activeController
            c.timeToNextAttack = 0
            c.hitboxMagnitude = 85
            c.attacking = false
            c.blocking = false
        end
    end)
    pcall(function()
        VU:CaptureController()
        VU:Button1Down(Vector2.new(0, 0))
    end)
    task.wait(0.025)
    pcall(function()
        VU:Button1Up(Vector2.new(0, 0))
    end)
    pcall(function()
        local cam = workspace.CurrentCamera
        local x, y = 400, 300
        if cam then
            x = cam.ViewportSize.X / 2
            y = cam.ViewportSize.Y / 2
        end
        VIM:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(0.012)
        VIM:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)
    pcall(function()
        local c = LP.Character
        if c then
            local t = c:FindFirstChildOfClass("Tool")
            if t then t:Activate() end
        end
    end)
end

local function GetEnemy(range)
    local h = HRP()
    if not h then return nil end
    local near, best = nil, range or 5000
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return nil end
    for _, m in pairs(folder:GetChildren()) do
        local mh = m:FindFirstChild("HumanoidRootPart")
        local hum = m:FindFirstChildOfClass("Humanoid")
        if mh and hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(m) then
            local d = (h.Position - mh.Position).Magnitude
            if d < best then
                near = m
                best = d
            end
        end
    end
    return near
end

local function GetFarEnemy(minD)
    local h = HRP()
    if not h then return nil end
    local best, bestD = nil, math.huge
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return nil end
    for _, m in pairs(folder:GetChildren()) do
        local mh = m:FindFirstChild("HumanoidRootPart")
        local hum = m:FindFirstChildOfClass("Humanoid")
        if mh and hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(m) then
            local d = (h.Position - mh.Position).Magnitude
            if d > (minD or 50) and d < bestD then
                best = m
                bestD = d
            end
        end
    end
    return best
end

local function lerp(a, b, t)
    return a + (b - a) * t
end

