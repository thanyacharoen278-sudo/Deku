RunService.Heartbeat:Connect(function(dt)
    if not (_G.AutoFarm or _G.AutoRaid) then return end
    pcall(function()
        local h = HRP()
        if not h then return end
        local enemy = GetEnemy(120)
        if not enemy and _G.AutoRaid then
            enemy = GetFarEnemy(50) or GetEnemy(10000)
        end
        if not enemy and _G.AutoFarm then
            enemy = GetEnemy(5000)
        end
        if not enemy then return end
        local eh = enemy:FindFirstChild("HumanoidRootPart")
        if not eh then return end
        local height = _G.FarmHeight or 14
        if height < 10 then height = 12 end
        local targetPos = eh.Position + Vector3.new(0, height, 0)
        local cur = h.Position
        local dist = (targetPos - cur).Magnitude
        local alpha = math.clamp((dt or 0.016) * 14, 0.1, 0.4)
        local newPos
        if dist > 90 then
            newPos = targetPos
        else
            newPos = Vector3.new(
                lerp(cur.X, targetPos.X, alpha),
                lerp(cur.Y, targetPos.Y, alpha),
                lerp(cur.Z, targetPos.Z, alpha)
            )
        end
        h.CFrame = CFrame.new(newPos, eh.Position)
        h.Velocity = Vector3.new(0, 0, 0)
        pcall(function() h.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
        local hum = Hum()
        if hum then
            hum.WalkSpeed = 0
            hum.JumpPower = 0
        end
    end)
end)

